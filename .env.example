# =============================================================================
# İadeAjan — Ortam Değişkenleri Şablonu
# =============================================================================
# Kurulum:  cp .env.example .env
# Ardından .env içindeki değerleri doldurun. Bu dosyayı asla gerçek anahtarlarla
# commit etmeyin (.env zaten .gitignore içindedir).
# =============================================================================

# ── Google Gemini (LLM) ───────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Alternatif isim (GOOGLE_API_KEY varsa o kullanılır):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM tabanlı anomali denetimi (false → yalnızca Python kural motoru)
LLM_ANOMALY_ENABLED=true

# Tabular → kanonik dönüşümde LLM'e gönderilen örnek satır sayısı
MAX_LLM_TABULAR_ROWS=5

# ── Excel / CSV yükleme limitleri ───────────────────────────────────────────
MAX_UPLOAD_ROWS=50000
LARGE_EXCEL_READ_ONLY_THRESHOLD=10000

# ── GİB / e-Fatura / Gümrük doğrulama ───────────────────────────────────────
# Gerçek GİB HTTP API (prod dışı demo için false bırakın)
ENABLE_REAL_GIB_API=false

# GIB_VERIFICATION_MODE: off | mock | stub | live (registry fabrikası)
GIB_VERIFICATION_MODE=stub
GIB_API_URL=
GIB_API_KEY=
GIB_EFATURA_API_URL=
GIB_VERIFY_PATH=/v1/declarations/verify
GIB_API_TIMEOUT_SEC=15
# Geriye uyumluluk (tercihen GIB_VERIFICATION_MODE kullanın):
# ENABLE_GIB_MOCK=true

# e-Fatura doğrulama: off | stub | live
EFATURA_VERIFICATION_MODE=off
EFATURA_API_URL=
EFATURA_API_KEY=

# Gümrük çıkış beyanı: off | stub | live
CUSTOMS_VERIFICATION_MODE=off
CUSTOMS_API_URL=
CUSTOMS_API_KEY=

# ── Zero Trust / kanıt defteri ────────────────────────────────────────────────
# local | test | production — TTL ve audit davranışı
VERIFICATION_ENV=local
APP_ENV=local

STRICT_PROOF=true
REQUIRE_VERIFIED_PROOF=true
STRICT_INVENTORY_TRUST=true

# Upload başarısız olunca demo mock senaryoya düş (prod: false)
ALLOW_MOCK_FALLBACK=true

# Belge çıkarma: true → mock (pytest); prod için false
MOCK_DOCUMENT_EXTRACTION=false

# PDF/görsel sınıflandırma (Gemini)
DOCUMENT_CLASSIFIER_ENABLED=true

# Doğrulama audit logu (logs/verification_audit.jsonl)
VERIFICATION_AUDIT_ENABLED=true

# Çapraz doğrulama tarih toleransı (gün)
VERIFICATION_DATE_TOLERANCE_DAYS=30

# Test artefaktlarını diske yaz (yalnızca geliştirme)
ALLOW_TEST_ARTIFACTS=false

# ── Güvenlik (opsiyonel) ──────────────────────────────────────────────────────
# Tanımlıysa API isteklerinde kontrol edilir; boş → devre dışı
IADEAJAN_API_KEY=

# ── Test / CI ─────────────────────────────────────────────────────────────────
# Entegrasyon testlerini zorla (varsayılan kapalı)
RUN_INTEGRATION_TESTS=0
